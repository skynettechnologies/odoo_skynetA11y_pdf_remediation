<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="res_groups_privilege_pdf_remediation" model="res.groups.privilege">
            <field name="name">SkynetA11y PDF Remediation</field>
            <field name="sequence">60</field>
            <field name="category_id" ref="base.module_category_services"/>
        </record>

        <record id="group_pdf_remediation_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Can open the SkynetA11y PDF Remediation dashboard: upload or scan documents, run AI remediation and download the results.</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_pdf_remediation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Settings / Administration users can always use the dashboard. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('odoo_skyneta11y_pdf_remediation.group_pdf_remediation_user'))]"/>
        </record>

        <!--
            Lock the module's system parameters (API URL, dashboard URL, keys,
            account...). Odoo 20 replaced ir.rule / ir.model.access with ir.access.
            A record with NO group is a restriction that applies to every user,
            administrators included. operation "cud" = create, update, delete:
            reading stays allowed so the dashboard still works. Module
            install/upgrade and sudo()/superuser code are not affected.
        -->
        <record id="access_pdf_remediation_params_locked" model="ir.access">
            <field name="name">SkynetA11y PDF Remediation: parameters are read-only</field>
            <field name="model_id" ref="base.model_ir_config_parameter"/>
            <field name="operation">cud</field>
            <field name="domain">['!', ('key', '=like', 'odoo_skynetA11y_pdf_remediation.%')]</field>
        </record>

    </data>
</odoo>
