<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Default values only. noupdate="1" so a module upgrade never overwrites them.
        The parameters are locked read-only by security/security.xml (ir.access).

        NOTE: the provisioning API key IS handed to the browser by the dashboard
        server action (data-only build, no controller).
    -->
    <data noupdate="1">

        <!-- Origin of the remediation backend. -->
        <record id="param_api_base_url" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.api_base_url</field>
            <field name="value">https://livepdfapi.skynettechnologies.us</field>
        </record>

        <!-- Used by the dashboard to sign the account in (sent to the browser; there is no server controller). -->
        <record id="param_provision_api_key" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.provision_api_key</field>
            <field name="value">PDF-REMEDATION-PLAN-CHECK</field>
        </record>

        <!-- Pin the account name. Leave blank to let the dashboard ask on first use. -->
        <record id="param_account_name" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.account_name</field>
            <field name="value"></field>
        </record>

        <!-- Fill in BOTH account_email and website to pin the account and skip the dialog. -->
        <record id="param_account_email" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.account_email</field>
            <field name="value"></field>
        </record>

        <!-- Domain the account is registered against. -->
        <record id="param_website" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.website</field>
            <field name="value"></field>
        </record>

        <!-- Plan new accounts are provisioned on. -->
        <record id="param_plan_id" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.plan_id</field>
            <field name="value">free</field>
        </record>

        <!-- Two-letter country code recorded on the account. -->
        <record id="param_country" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.country</field>
            <field name="value">US</field>
        </record>

        <!-- Dashboard the plan-upgrade button links to. -->
        <record id="param_dashboard_url" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.dashboard_url</field>
            <field name="value">https://ada.skynettechnologies.us</field>
        </record>

        <!-- Override the upgrade autologin link. Blank derives it from the website. -->
        <record id="param_upgrade_url" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.upgrade_url</field>
            <field name="value"></field>
        </record>

        <!-- Domain the Website Scan tab crawls. Blank follows the account domain. -->
        <record id="param_active_domain" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.active_domain</field>
            <field name="value"></field>
        </record>

        <!-- Tab to open on load: upload, scan or remediated. Blank honours ?tab= in the URL. -->
        <record id="param_initial_tab" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.initial_tab</field>
            <field name="value"></field>
        </record>

        <!-- localStorage key the session token is cached under in the browser. -->
        <record id="param_token_key" model="ir.config_parameter">
            <field name="key">odoo_skynetA11y_pdf_remediation.token_key</field>
            <field name="value">skyneta11y_token</field>
        </record>

    </data>
</odoo>
